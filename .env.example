# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Client ID ("Web application" type).
# One client ID covers both YouTube and Google Drive — no client secret needed.
# 1. https://console.cloud.google.com/apis/credentials -> Create Credentials -> OAuth client ID
# 2. Enable "YouTube Data API v3" and "Google Drive API" under APIs & Services
# 3. Authorized JavaScript origins: must exactly match where you run this app, e.g. http://localhost:3000
# 4. OAuth consent screen: add scopes youtube.readonly + drive.metadata.readonly,
#    and add your Google account under "Test users" while the app is unverified.
VITE_GOOGLE_CLIENT_ID=""

# Firebase — 회원 정보 및 성향 분석 점수 저장 (익명 인증 + Firestore).
# 미설정 시 앱은 localStorage 전용 모드로 정상 동작합니다.
# https://console.firebase.google.com -> 프로젝트 설정 -> 내 앱 -> 웹 앱 등록 후 값 복사
# Authentication -> 로그인 방법 -> "익명" 사용 설정 필요
# Firestore Database 생성 필요
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
